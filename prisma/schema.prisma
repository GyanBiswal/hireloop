generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String        @id @default(cuid())
  name       String
  email      String        @unique
  password   String
  role       Role          @default(RECRUITER)
  createdAt  DateTime      @default(now())
  referrals  Application[] @relation("Referrer")
  auditLogs  AuditLog[]    @relation("Actor")
  jobs       Job[]         @relation("CreatedBy")
  scorecards Scorecard[]   @relation("Reviewer")
}

model Job {
  id             String          @id @default(cuid())
  title          String
  department     String
  description    String
  location       String
  status         JobStatus       @default(DRAFT)
  createdById    String
  createdAt      DateTime        @default(now())
  applications   Application[]
  createdBy      User            @relation("CreatedBy", fields: [createdById], references: [id])
  pipelineStages PipelineStage[]
}

model PipelineStage {
  id            String        @id @default(cuid())
  name          String
  order         Int
  color         String
  jobId         String
  applications  Application[] @relation("CurrentStage")
  auditLogsFrom AuditLog[]    @relation("FromStage")
  auditLogsTo   AuditLog[]    @relation("ToStage")
  job           Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Candidate {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String
  resumeUrl    String?
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Application {
  id             String            @id @default(cuid())
  candidateId    String
  jobId          String
  currentStageId String
  referrerId     String?
  status         ApplicationStatus @default(ACTIVE)
  appliedAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  candidate      Candidate         @relation(fields: [candidateId], references: [id])
  currentStage   PipelineStage     @relation("CurrentStage", fields: [currentStageId], references: [id])
  job            Job               @relation(fields: [jobId], references: [id])
  referrer       User?             @relation("Referrer", fields: [referrerId], references: [id])
  auditLogs      AuditLog[]
  scorecards     Scorecard[]
}

enum InterviewType {
  PHONE_SCREEN
  TECHNICAL
  FINAL_ROUND
}

enum Recommendation {
  STRONG_HIRE
  HIRE
  NO_HIRE
  STRONG_NO_HIRE
}

model Scorecard {
  id                String @id @default(cuid())
  applicationId     String
  reviewerId        String

  interviewType     InterviewType
  recommendation    Recommendation

  technicalAbility  Int
  communication     Int
  problemSolving    Int
  cultureFit        Int

  strengths         String?
  concerns          String?

  rating            Int
  feedback          String

  createdAt         DateTime @default(now())

  application       Application @relation(fields: [applicationId], references: [id])
  reviewer          User @relation("Reviewer", fields: [reviewerId], references: [id])
}

model AuditLog {
  id            String         @id @default(cuid())
  applicationId String
  actorId       String
  fromStageId   String?
  toStageId     String?
  action        String
  note          String?
  createdAt     DateTime       @default(now())
  actor         User           @relation("Actor", fields: [actorId], references: [id])
  application   Application    @relation(fields: [applicationId], references: [id])
  fromStage     PipelineStage? @relation("FromStage", fields: [fromStageId], references: [id])
  toStage       PipelineStage? @relation("ToStage", fields: [toStageId], references: [id])
}

enum Role {
  ADMIN
  RECRUITER
  INTERVIEWER
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum ApplicationStatus {
  ACTIVE
  REJECTED
  HIRED
}
